{
  "name": "ai-visibility-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Track how often AI answer engines mention and cite your brand, with honest confidence ranges.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx --no-warnings=ExperimentalWarning scripts/seed.ts",
    "track": "tsx --no-warnings=ExperimentalWarning scripts/track.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
