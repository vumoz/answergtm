# Add a key for each engine you want to track. Engines without a key are skipped.
# With no keys at all, the app uses a simulated "demo" engine so you can try it.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Google AI Overviews are collected through SerpApi (serpapi.com).
SERPAPI_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-5-mini
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-opus-5-5

# Where the SQLite database lives (default ./data/tracker.db)
# DATABASE_PATH=./data/tracker.db

# Set to "off" to hide the demo engine once real keys are in place
# DEMO_ENGINE=off
